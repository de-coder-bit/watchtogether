# ==========================================
# WatchTogether Environment Configuration
# ==========================================

# 1. DATABASE (Neon.tech / Supabase / Local Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/watchtogether
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# 2. SECURITY & JWT (Generate random 256-bit hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 3. OBJECT STORAGE (Cloudflare R2 / Backblaze B2 / MinIO / Local)
# Options: "local" or "s3"
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage

# If using Cloudflare R2 / Backblaze B2:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=watchtogether
# S3_ACCESS_KEY=<r2_access_key_id>
# S3_SECRET_KEY=<r2_secret_access_key>
# S3_PUBLIC_URL=https://pub-<id>.r2.dev or https://media.yourdomain.com

# 4. FFMPEG LOCAL PATH (if not in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 5. FRONTEND CONFIG
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=http://localhost:8080/ws
