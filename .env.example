# ==========================================
# WatchTogether Environment Configuration
# ==========================================

# Server
PORT=8088

# Database (PostgreSQL - Neon.tech or Supabase free-tier)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.neon.tech/watchtogether?sslmode=require
SPRING_DATASOURCE_USERNAME=neon_user
SPRING_DATASOURCE_PASSWORD=neon_password

# JWT Authentication
JWT_SECRET=supersecretwatchtogetherjwtkeythatisminimum256bitslongandverysecure12345
JWT_EXPIRATION_MS=86400000

# Cloudflare R2 / S3 Object Storage (Zero-Egress Free Tier)
STORAGE_TYPE=s3
AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_BUCKET=watchtogether
AWS_S3_ACCESS_KEY=<r2-access-key-id>
AWS_S3_SECRET_KEY=<r2-secret-access-key>
AWS_S3_REGION=auto
AWS_S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# Frontend URL
FRONTEND_URL=http://localhost:5173
